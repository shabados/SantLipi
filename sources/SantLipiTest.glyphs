features = (
{
automatic = 1;
code = "feature isol;
feature init;
feature fina;
feature blwf;
feature pstf;
feature calt;
";
tag = aalt;
},
{
automatic = 1;
code = "sub aaMatra-gurmukhi by aaMatra-gurmukhi.isol;
sub i-gurmukhi by i-gurmukhi.isol;
sub ta-gurmukhi by ta-gurmukhi.isol;
sub ya-gurmukhi by ya-gurmukhi.isol;
sub ra-gurmukhi by ra-gurmukhi.isol;
sub sa-gurmukhi by sa-gurmukhi.isol;
sub ha-gurmukhi by ha-gurmukhi.isol;
";
tag = isol;
},
{
automatic = 1;
code = "sub aaMatra-gurmukhi by aaMatra-gurmukhi.init;
sub i-gurmukhi by i-gurmukhi.init;
sub ta-gurmukhi by ta-gurmukhi.init;
sub ya-gurmukhi by ya-gurmukhi.init;
sub ra-gurmukhi by ra-gurmukhi.init;
sub sa-gurmukhi by sa-gurmukhi.init;
sub ha-gurmukhi by ha-gurmukhi.init;
";
tag = init;
},
{
automatic = 1;
code = "sub aaMatra-gurmukhi by aaMatra-gurmukhi.fina;
sub i-gurmukhi by i-gurmukhi.fina;
sub ta-gurmukhi by ta-gurmukhi.fina;
sub ya-gurmukhi by ya-gurmukhi.fina;
sub ra-gurmukhi by ra-gurmukhi.fina;
sub sa-gurmukhi by sa-gurmukhi.fina;
sub ha-gurmukhi by ha-gurmukhi.fina;
";
tag = fina;
},
{
code = "script gur2;
sub halant-gurmukhi' ra-gurmukhi' by ra-gurmukhi.below;
sub halant-gurmukhi' va-gurmukhi' by va-gurmukhi.below;
sub halant-gurmukhi' ha-gurmukhi' by ha-gurmukhi.below;
script guru;
ignore sub [ra-gurmukhi.below va-gurmukhi.below ha-gurmukhi.below yakash-gurmukhi] [ra-gurmukhi va-gurmukhi ha-gurmukhi]' halant-gurmukhi';
sub ra-gurmukhi' halant-gurmukhi' by ra-gurmukhi.below;
sub va-gurmukhi' halant-gurmukhi' by va-gurmukhi.below;
sub ha-gurmukhi' halant-gurmukhi' by ha-gurmukhi.below;
";
tag = blwf;
},
{
code = "sub halant-gurmukhi ya-gurmukhi by ya-gurmukhi.post;";
tag = pstf;
},
{
code = "lookup NUKTA {
	sub sa-gurmukhi nukta-gurmukhi by sha-gurmukhi;
	sub ka-gurmukhi nukta-gurmukhi by ka_nukta-gurmukhi;
	sub kha-gurmukhi nukta-gurmukhi by khha-gurmukhi;
	sub ga-gurmukhi nukta-gurmukhi by ghha-gurmukhi;
	sub pa-gurmukhi nukta-gurmukhi by fa-gurmukhi;
	sub la-gurmukhi nukta-gurmukhi by lla-gurmukhi; 
} NUKTA;

lookup ATTACHMENTS {
	sub rra-gurmukhi ha-gurmukhi.below by rra_ha.below-gurmukhi;
} ATTACHMENTS;

lookup MULTIATTACH {
	sub ra-gurmukhi.below uMatra-gurmukhi by ra.below_uMatra-gurmukhi;
	sub ra-gurmukhi.below uuMatra-gurmukhi by ra.below_uuMatra-gurmukhi;
} MULTIATTACH;

lookup ISOLATED {
   ignore sub @Medial' @AllLetters, @AllLetters @Medial';
	ignore sub @AllNonspacingMarks @Medial', @Medial' @AllNonspacingMarks @AllLetters, @Medial' @AllNonspacingMarks @AllNonspacingMarks @AllLetters, @Medial' @AllNonspacingMarks @AllNonspacingMarks @AllNonspacingMarks @AllLetters, @Medial' @AllNonspacingMarks @AllNonspacingMarks @AllNonspacingMarks @AllNonspacingMarks @AllLetters;
   sub @Medial' by @Isolated;
} ISOLATED;

lookup INITIAL {
	ignore sub @AllNonspacingMarks @Medial';
	ignore sub @AllLetters @Medial';
	#sub iMatra-gurmukhi' @Medial by iMatra-gurmukhi.init;
	#sub @Medial' iiMatra-gurmukhi by @Isolated;
	sub @Medial' by @Initial;
} INITIAL;

lookup FINAL {
   ignore sub @Medial' @AllLetters;
	ignore sub @Medial' @AllNonspacingMarks @AllLetters, @Medial' @AllNonspacingMarks @AllNonspacingMarks @AllLetters, @Medial' @AllNonspacingMarks @AllNonspacingMarks @AllNonspacingMarks @AllLetters, @Medial' @AllNonspacingMarks @AllNonspacingMarks @AllNonspacingMarks @AllNonspacingMarks @AllLetters;
	sub @Medial' ya-gurmukhi.post by @MedialBeforeYa;
	sub @Initial' ya-gurmukhi.post by @InitialBeforeYa;
	#sub iMatra-gurmukhi @Medial' by @Isolated;
	#sub @Medial' iiMatra-gurmukhi by @Initial;
   sub @Medial' by @Final;
} FINAL;

lookup ALTSTEM {
	sub @MidStem ooMatra-gurmukhi' by ooMatra-gurmukhi.narrow;
	sub @LeftStem ooMatra-gurmukhi' by ooMatra-gurmukhi.reverse;
} ALTSTEM;";
tag = calt;
}
);
